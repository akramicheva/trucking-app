{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Backend",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build", // Убедитесь, что эта таска есть в tasks.json
      "program": "${workspaceFolder}/TruckingApp.Server/bin/Debug/net9.0/TruckingApp.Server.dll", // Укажите правильный путь к вашей dll
      "args": [  
        "build",
        "${workspaceFolder}/TruckingApp.Server/TruckingApp.Server.csproj",
        "-c", "Debug" // Принудительный Debug
      ],
      "cwd": "${workspaceFolder}/TruckingApp.Server",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "React Frontend",
      "type": "chrome", // Или "msedge", если используете Edge
      "request": "launch",
      "url": "http://localhost:5173", // URL, который открывает SPA Proxy (обычно прописан в launchSettings.json бэкенда)
      "webRoot": "${workspaceFolder}/TruckingApp.client", // Путь к папке с React-приложением
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Frontend)",
      "configurations": [".NET Backend", "React Frontend"]
    }
  ]
}